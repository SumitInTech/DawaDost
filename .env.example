# TinyFish API Configuration
TINYFISH_API_KEY=

# LLM Configuration (for extraction and salt resolution fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Cache Configuration
CACHE_DB_PATH=backend/cache.db
CACHE_TTL_MINUTES=1440
USE_CACHE_ONLY=false

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
