{
  "name": "dawadost-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dawa Dost - Medicine Price Comparison & Bio-Equivalence Monorepo",
  "scripts": {
    "install:all": "npm --prefix frontend install",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/start-backend.js",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "node scripts/run-tests.js",
    "test:benchmark": "node scripts/run-benchmark.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
